<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OpenNest.Avalonia</RootNamespace>
    <AssemblyName>OpenNest.Avalonia</AssemblyName>
    <Nullable>disable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenNest.Core\OpenNest.Core.csproj" />
    <ProjectReference Include="..\OpenNest.IO\OpenNest.IO.csproj" />
    <ProjectReference Include="..\OpenNest.Desktop\OpenNest.Desktop.csproj" />
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The posts the WinForms app ships, built with this app and copied to its Posts/ directory. -->
    <ProjectReference Include="..\Posts\OpenNest.Posts.Cincinnati\OpenNest.Posts.Cincinnati.csproj" ReferenceOutputAssembly="false" IsPost="true" />
    <ProjectReference Include="..\Posts\OpenNest.Posts.CincinnatiCIFiber\OpenNest.Posts.CincinnatiCIFiber.csproj" ReferenceOutputAssembly="false" IsPost="true" />
  </ItemGroup>
  <!-- As for the WinForms app: each post DLL, and its shipped settings JSON unless one is already
       deployed (an edited copy is kept), go to Posts/ beside the app, which loads them at startup. -->
  <Target Name="CopyPostsToOutput" AfterTargets="Build">
    <MSBuild Projects="@(ProjectReference)" Condition="'%(ProjectReference.IsPost)' == 'true'" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="PostAssembly" />
    </MSBuild>
    <ItemGroup>
      <PostConfig Include="@(PostAssembly->'%(RootDir)%(Directory)%(Filename).json')" />
      <PostConfigToCopy Include="@(PostConfig)" Condition="Exists('%(FullPath)') and !Exists('$(OutDir)Posts\%(Filename)%(Extension)')" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)Posts" />
    <Copy SourceFiles="@(PostAssembly)" DestinationFolder="$(OutDir)Posts" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PostConfigToCopy)" DestinationFolder="$(OutDir)Posts" SkipUnchangedFiles="true" />
  </Target>
</Project>
